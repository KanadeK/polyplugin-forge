:root {
  color-scheme: light dark;
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
    sans-serif;
  background: #0d1514;
  color: #f4f8f2;
}

* {
  box-sizing: border-box;
}

body {
  width: 360px;
  min-height: 260px;
  margin: 0;
  background:
    radial-gradient(circle at 85% 12%, rgb(100 213 170 / 18%), transparent 34%),
    #0d1514;
}

.popup {
  display: grid;
  gap: 0.8rem;
  padding: 1.25rem;
}

.eyebrow {
  margin: 0;
  color: #7ee0b7;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

h1 {
  margin: 0;
  font-size: 1.45rem;
  line-height: 1.15;
}

.description {
  margin: 0 0 0.25rem;
  color: #bac7c2;
  font-size: 0.88rem;
  line-height: 1.5;
}

label {
  font-size: 0.82rem;
  font-weight: 650;
}

.controls {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.55rem;
}

input,
button {
  min-height: 2.55rem;
  border: 1px solid #40534d;
  border-radius: 0.6rem;
  font: inherit;
}

input {
  min-width: 0;
  padding: 0.55rem 0.7rem;
  background: #15211f;
  color: inherit;
}

button {
  padding: 0.55rem 0.85rem;
  border-color: #7ee0b7;
  background: #7ee0b7;
  color: #092019;
  cursor: pointer;
  font-weight: 750;
}

button:disabled {
  cursor: wait;
  opacity: 0.65;
}

input:focus-visible,
button:focus-visible {
  outline: 3px solid #f3c969;
  outline-offset: 2px;
}

.output {
  min-height: 3rem;
  margin: 0.3rem 0 0;
  padding: 0.75rem;
  border: 1px solid #2c403a;
  border-radius: 0.6rem;
  background: rgb(255 255 255 / 4%);
  color: #dce8e3;
  font-size: 0.88rem;
  line-height: 1.45;
}

@media (prefers-reduced-motion: no-preference) {
  button {
    transition:
      background-color 120ms ease,
      transform 120ms ease;
  }

  button:not(:disabled):active {
    transform: translateY(1px);
  }
}
